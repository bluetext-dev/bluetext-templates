<config xmlns="http://tail-f.com/ns/config/1.0">
  <facilities xmlns="https://curity.se/ns/conf/base">
    <data-sources>
      <data-source>
        <id>default-datasource</id>
        <jdbc xmlns="https://curity.se/ns/ext-conf/jdbc">
          <!-- host resolves at file-config render time from the couchbase
               link ConfigMap; the password stays a secrets:: placeholder for
               the bluetext-render init container to substitute in-pod from the
               projected per-value-id Secret. The admin user is Couchbase's
               well-known non-secret default literal (config::links carries only
               host/port/metadata, not the bundle credential, and
               value::couchbase-server-username is not visible in curity's
               render scope — auth-stack goal issue I-3). ssl=false: the
               in-cluster Couchbase server variant this wrapper targets is
               plaintext. The 32-char alphanumeric password is URL-safe in the
               connection string. -->
          <connection-string>jdbc:postgresql:couchbase://$bt{{ config::links.couchbase.host }}?catalog=curity&amp;user=Administrator&amp;password=$bt{{ secrets::couchbase-server-password }}&amp;ssl=false</connection-string>
          <driver>dev.bluetext.jdbc.CouchbasePostgresDriver</driver>
          <standard-credentials-mode/>
        </jdbc>
      </data-source>
    </data-sources>
    <caching-services>
      <default-caching-service>
        <data-source>default-datasource</data-source>
      </default-caching-service>
    </caching-services>
  </facilities>

  <processing xmlns="https://curity.se/ns/conf/base">
    <account-managers>
      <account-manager>
        <id>default-account-manager</id>
        <account-data-source>default-datasource</account-data-source>
        <enable-registration>
          <account-verification-method>no-verification</account-verification-method>
        </enable-registration>
      </account-manager>
    </account-managers>
    <credential-managers>
      <credential-manager>
        <id>default-credential-manager</id>
        <data-source-backed>
          <data-source-id>default-datasource</data-source-id>
        </data-source-backed>
        <!-- Curity hashes credentials with BCrypt (cost 10) on write and
             bcrypt-verifies on read, producing the `$2a$` prefix. Reaches
             Couchbase through the JDBC wrapper as an already-hashed value;
             nothing downstream hashes, so this element is what makes hashing
             happen. Omitting it leaves the bucket storing plaintext (Curity
             11.x dropped the implicit-bcrypt default). -->
        <BCrypt>
          <cost>10</cost>
        </BCrypt>
      </credential-manager>
    </credential-managers>
  </processing>
</config>
