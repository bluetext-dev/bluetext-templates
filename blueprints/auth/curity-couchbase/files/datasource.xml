<config xmlns="http://tail-f.com/ns/config/1.0">
  <facilities xmlns="https://curity.se/ns/conf/base">
    <data-sources>
      <data-source>
        <id>default-datasource</id>
        <couchbase xmlns="https://curity.se/ns/ext-conf/couchbase">
          <!-- Connection facts resolve at file-config render time, not via
               env vars + sed: host from the couchbase link's ConfigMap. The
               password is left as a secrets:: placeholder for the
               bluetext-render init container to substitute in-pod from the
               projected per-value-id Secret (never in the manifest or an env
               var). The admin user-name is Couchbase's well-known non-secret
               default; it is a literal because config::links carries only
               host/port/metadata (not the auth bundle's credential), and
               value::couchbase-server-username is couchbase's per-abstract
               value, not visible in curity's file-config render scope (see the
               auth-stack goal issue I-3). use-tls is plaintext: the in-cluster
               Couchbase server variant this plugin targets serves unencrypted;
               a Capella + curity-plugin combo would source TLS from the bound
               variant (not currently exercised). -->
          <host>$bt{{ config::links.couchbase.host }}</host>
          <use-tls>false</use-tls>
          <user-name>Administrator</user-name>
          <password>$bt{{ secrets::couchbase-server-password }}</password>
          <bucket>curity</bucket>
          <scope>_default</scope>
          <claim-query>SELECT `:collection`.* FROM `:bucket`.`:scope`.`:collection` WHERE META().id = "node::user::personal_info:::subject"</claim-query>
        </couchbase>
      </data-source>
    </data-sources>
    <caching-services>
      <default-caching-service>
        <data-source>default-datasource</data-source>
      </default-caching-service>
    </caching-services>
  </facilities>

  <processing xmlns="https://curity.se/ns/conf/base">
    <account-managers>
      <account-manager>
        <id>default-account-manager</id>
        <account-data-source>default-datasource</account-data-source>
        <enable-registration>
          <account-verification-method>no-verification</account-verification-method>
        </enable-registration>
      </account-manager>
    </account-managers>
    <credential-managers>
      <credential-manager>
        <id>default-credential-manager</id>
        <data-source-backed>
          <data-source-id>default-datasource</data-source-id>
        </data-source-backed>
        <!-- Curity hashes credentials with BCrypt (cost 10) on write and
             bcrypt-verifies on read, producing the `$2a$` prefix. The
             Couchbase plugin's CredentialDataAccessProvider.store() receives
             the already-hashed value and persists it verbatim — it does not
             hash itself, so this element is what makes hashing happen.
             Omitting it leaves the bucket storing plaintext (Curity 11.x
             dropped the implicit-bcrypt default). -->
        <BCrypt>
          <cost>10</cost>
        </BCrypt>
      </credential-manager>
    </credential-managers>
  </processing>
</config>
