<config xmlns="http://tail-f.com/ns/config/1.0">
  <environments xmlns="https://curity.se/ns/conf/base">
    <environment>
      <!-- base-url MUST use the route-token host, NOT __NAMESPACE__. Curity
           builds self-referential redirects (e.g. the authorize → /authn login
           page) from base-url, and the deploy tokenizes every
           .{namespace}.bluetext.localhost ingress host to a short route-token
           (route_host.rs). The browser reaches Curity at
           curity.<route-token>.bluetext.localhost (the web-app's auth-config.ts
           derives that authority by rewriting kong.→curity. on its own host),
           so an authn redirect built from the untokenized __NAMESPACE__ host
           would 404 — and crossing hosts mid-flow would also drop Curity's
           session cookie. The curity config init seds __ROUTE_TOKEN__ to the
           same token the ingress carries (deploy::route-token). -->
      <base-url>http://curity.__ROUTE_TOKEN__.bluetext.localhost</base-url>
      <services>
        <service-role>
          <id>default</id>
          <protocol>http</protocol>
        </service-role>
      </services>
    </environment>
  </environments>
</config>
