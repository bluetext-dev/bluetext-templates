<config xmlns="http://tail-f.com/ns/config/1.0">
  <profiles xmlns="https://curity.se/ns/conf/base">
    <profile>
      <id>token-service</id>
      <type xmlns:as="https://curity.se/ns/conf/profile/oauth">as:oauth-service</type>
      <settings>
        <authorization-server xmlns="https://curity.se/ns/conf/profile/oauth">
          <client-store>
            <config-backed>
              <client>
                <id>web-app</id>
                <client-name>Web App</client-name>
                <no-authentication>true</no-authentication>
                <!-- Same-origin: the browser reaches the SPA and lands the
                     OIDC callback on Kong's host (phantom token needs
                     same-origin; Kong is the single front door, the web-app
                     has no Ingress). The deploy tokenizes every
                     .bluetext.localhost ingress host to a short route-token
                     (route_host.rs), so the browser host is
                     kong.<route-token>.bluetext.localhost. The ROUTE_TOKEN
                     placeholder below is substituted to that same token by
                     the curity config init (from the deploy route-token
                     value); the full namespace would mismatch and Curity
                     would 400 the callback. The lvh.me line stays on the full
                     namespace, matching route_host.rs.
                     CAUTION: never write the namespace placeholder token in an
                     XML comment — the init expands it to the full namespace,
                     whose double-hyphen is illegal inside XML comments and
                     crashes Curity's config parser. -->
                <redirect-uris>http://kong.__ROUTE_TOKEN__.bluetext.localhost/auth/callback</redirect-uris>
                <redirect-uris>http://kong.__NAMESPACE__.bluetext.lvh.me/auth/callback</redirect-uris>
                <scope>openid</scope>
                <scope>profile</scope>
                <scope>email</scope>
                <scope>roles</scope>
                <capabilities>
                  <code/>
                </capabilities>
                <!-- Required presence container for any client using the Code
                     flow (per the profile-oauth YANG: user-authentication
                     "Must be set if Code, Implicit, Assisted or Device Flow is
                     used"). Without it Curity logs "No user authentication
                     settings were provided, but using an authenticated flow.
                     The configuration is wrong … will be made mandatory in a
                     future release." allowed-authenticators is a leafref into
                     the bound authentication-profile's authenticators — here
                     the html-form authenticator from oauth-config.xml. -->
                <user-authentication>
                  <allowed-authenticators>html-form</allowed-authenticators>
                </user-authentication>
                <proof-key>
                  <require-proof-key>true</require-proof-key>
                </proof-key>
                <use-pairwise-subject-identifiers>
                  <sector-identifier>bluetext-web-app</sector-identifier>
                </use-pairwise-subject-identifiers>
              </client>
            </config-backed>
          </client-store>
        </authorization-server>
      </settings>
    </profile>
  </profiles>
</config>
